# ---------------------------------------------------------------------------
# HisabKitaab web app. Copy to apps/web/.env.local and fill in.
# NEXT_PUBLIC_* values are embedded in the browser bundle: they identify your
# Firebase project and are safe to expose (security comes from firestore.rules).
# Everything else is server-only. Never commit real values.
# ---------------------------------------------------------------------------

# Local development against the Firebase Emulator Suite (npm run emulators).
# When true, the demo project below is used and no real Firebase project is needed.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Firebase web app config (Firebase console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-hisabkitaab.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-hisabkitaab
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Base URL of the HisabKitaab API (Cloud Function "hkApi").
#   Emulator:   http://127.0.0.1:5001/demo-hisabkitaab/asia-south1/hkApi
#   Production: https://hisabkitaab-ideathon.web.app   (Hosting rewrites /api/** to hkApi)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5001/demo-hisabkitaab/asia-south1/hkApi

# Public download link for the Android app (served by Firebase Hosting).
NEXT_PUBLIC_ANDROID_APK_URL=https://hisabkitaab-ideathon.web.app/downloads/HisabKitaab.apk

# Messaging provider secrets live with the Cloud Function, not here: see functions/.env.example
