# Cloud Functions environment. Copy to functions/.env.ideathon-projects (deploy)
# or functions/.env.local (emulator). Never commit real values.
#
# Messaging providers: twilio | mock | (empty = disabled)
# With both disabled, the apps fall back to WhatsApp link / share / copy,
# which always works. "mock" stores results as SIMULATED, never SENT.
SMS_PROVIDER=
WHATSAPP_PROVIDER=

# Twilio credentials. For production, prefer Secret Manager:
#   firebase functions:secrets:set TWILIO_AUTH_TOKEN
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

APP_TIMEZONE=Asia/Kolkata
MESSAGE_RATE_LIMIT_PER_HOUR=30
